{
  "permissions": {
    "allow": [
      "Bash(node tools/*)",
      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Read(**)",
      "Write(web/**)",
      "Write(tools/**)",
      "Write(docs/**)",
      "Write(CLAUDE.md)",
      "Write(README.md)",
      "Write(.claude/**)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Write(config/admob_ids.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
